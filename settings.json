{
  "model": "sonnet",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/restore-hook-permissions.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/record-agent-dispatch-provenance.sh"
          }
        ]
      },
      {
        "matcher": "Write|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/v-artifact-board.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/durable-artifact-copy.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/fork-payload-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/commit-witness-recorder.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/record-codex-dispatch-provenance.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-compact-worktree.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/capture-skill-args.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-haiku-dispatch.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-fork-agent-dispatch.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/refresh-session-id.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-safety.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/database-destruction-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-main-branch.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-pre-commit-gates.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-pr-creation.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dependency-install-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-vtmp-typo.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-v-polling.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/track-session-writes.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-cross-session-add.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-branch-gate.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-write-boundary.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/readonly-edit-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/track-session-writes.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/artifact-location-check.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/protect-agent-review.sh"
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-v-polling.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*create_pull_request.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-pr-creation.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-export-sid.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-session-branch.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-marker.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-drain-deferred-merges.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/abandonment-telemetry.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/check-review-artifact.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/uncommitted-changes-gate.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-drain-deferred-merges.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/capture-user-prompt.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/detect-readonly-intent.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-agent-review.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-php-setup.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-remove.sh"
          }
        ]
      }
    ]
  }
}
